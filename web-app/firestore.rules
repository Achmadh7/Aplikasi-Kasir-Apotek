rules_version = '2';

// Apotek Lestari - Mode Online:
// 1) Koleksi bersama web_* di apotek/main diakses akun terverifikasi yang terdaftar di Authority (delete khusus Owner).
// 2) Koleksi web_* lama di users/{uid} tetap diizinkan untuk migrasi otomatis ke apotek/main.
// 3) Koleksi non-web_ (APK Android) tetap terisolasi per users/{uid}.
// 4) Dokumen authority/config hanya bisa dibaca akun Authority & ditulis akun ber-role Owner.
// 5) Dokumen authority/pin hanya bisa dibaca & ditulis oleh Owner.
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedAuth() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isDefaultOwner() {
      return isVerifiedAuth()
        && request.auth.token.email.lower() in ['achmadhida66@gmail.com', 'hanyrahayu19@gmail.com'];
    }

    function hasAuthorityDoc() {
      return exists(/databases/$(database)/documents/authority/config);
    }

    function authorityCfg() {
      return get(/databases/$(database)/documents/authority/config).data;
    }

    function isOwner() {
      return isVerifiedAuth() && (
        (
          hasAuthorityDoc()
          && 'ownerEmails' in authorityCfg()
          && authorityCfg().ownerEmails is list
          && authorityCfg().ownerEmails.size() > 0
        )
          ? request.auth.token.email.lower() in authorityCfg().ownerEmails
          : isDefaultOwner()
      );
    }

    function isAuthorized() {
      return isOwner()
        || (
          isVerifiedAuth()
          && hasAuthorityDoc()
          && 'emails' in authorityCfg()
          && authorityCfg().emails is list
          && request.auth.token.email.lower() in authorityCfg().emails
        );
    }

    match /apotek/main/{col}/{docId} {
      allow read: if col.matches('web_.*') && isAuthorized();
      allow create: if col.matches('web_.*') && col != 'web_meta' && (
        isOwner()
        || (
          isAuthorized()
          && (
            !(col in ['web_penjualan', 'web_penjualan_item', 'web_kas'])
            || request.resource.data.terhapus == false
          )
        )
      );
      allow update: if col.matches('web_.*') && col != 'web_meta' && (
        isOwner()
        || (
          isAuthorized()
          && !(col in ['web_penjualan', 'web_penjualan_item'])
          && (
            col != 'web_kas'
            || (resource.data.source != 'sale' && request.resource.data.source != 'sale')
          )
        )
      );
      allow write: if col == 'web_meta' && isOwner();
      allow delete: if col.matches('web_.*') && isOwner();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{col}/{docId} {
      allow read, write: if col.matches('web_.*')
        ? (isAuthorized() && request.auth.uid == uid)
        : (request.auth != null && request.auth.uid == uid);
    }

    match /users/{uid}/{col}/{docId}/{rest=**} {
      allow read, write: if !col.matches('web_.*')
        && request.auth != null
        && request.auth.uid == uid;
    }

    match /authority/config {
      allow read: if isAuthorized();
      allow write: if isOwner();
    }

    match /authority/pin {
      allow read, write: if isOwner();
    }
  }
}
