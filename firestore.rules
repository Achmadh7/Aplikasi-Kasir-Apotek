rules_version = '2';

// Apotek Lestari - Mode Online:
// 1) Setiap pengguna hanya boleh membaca & menulis datanya sendiri di users/{uid}.
// 2) Koleksi authority menyimpan daftar email yang diizinkan login di web.
// Tempel isi file ini di Firebase Console > Firestore Database > Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /authority/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email in ['achmadhida66@gmail.com', 'hanyrahayu19@gmail.com']
        || (
          exists(/databases/$(database)/documents/authority/config)
          && request.auth.token.email in get(/databases/$(database)/documents/authority/config).data.emails
        )
      );
    }
  }
}
