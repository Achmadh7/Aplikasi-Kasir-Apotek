rules_version = '2';

// Apotek Lestari - Mode Online: setiap pengguna hanya boleh membaca dan
// menulis pohon datanya sendiri di users/{uid}. Tempel isi file ini di
// Firebase Console > Firestore Database > Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
